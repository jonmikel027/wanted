# Puerto del servidor Express
SERVER_PORT=3000

# Dirección de conexión a MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/wanted

# Clave de verificación de Tokens
# Ejecuta el comando y sustituye el marcador por su resultado:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=generar_una_clave_secreta
JWT_EXPIRES_IN=24h
JWT_ALGORITHM=HS256